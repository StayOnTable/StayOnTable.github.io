# Keep empty for the root StayOnTable.github.io repository.
NEXT_PUBLIC_BASE_PATH=
NEXT_PUBLIC_SITE_URL=https://stayontable.github.io

# Public values only; all Secret values belong in the Cloudflare Worker.
NEXT_PUBLIC_ASK_API_URL=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Giscus is hidden until every value below is configured.
NEXT_PUBLIC_GISCUS_REPO=
NEXT_PUBLIC_GISCUS_REPO_ID=
NEXT_PUBLIC_GISCUS_CATEGORY=
NEXT_PUBLIC_GISCUS_CATEGORY_ID=
